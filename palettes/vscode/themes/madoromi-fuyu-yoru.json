      "settings": {
        "foreground": "#b5d43b"
      }
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#9197b2",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
