        "constant.numeric",
        "constant.language",
        "constant.other",
        "variable.other.constant",
        "support.constant"
      ],
      "settings": {
        "foreground": "#ff843d"
      }
    },
    {
      "scope": [
        "variable.other.enummember",
        "entity.name.variable.enum-member"
      ],
      "settings": {
        "foreground": "#00e6ac"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call entity.name.function",
        "support.function",
        "variable.function"
