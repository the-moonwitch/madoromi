      "settings": {
        "foreground": "#fd5217"
      }
    },
    {
      "scope": [
        "markup.inserted",
        "punctuation.definition.inserted"
      ],
      "settings": {
        "foreground": "#5e8933"
      }
    },
    {
      "scope": [
        "markup.deleted",
        "punctuation.definition.deleted"
