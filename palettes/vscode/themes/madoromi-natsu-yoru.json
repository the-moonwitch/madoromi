  "tokenColors": [
    {
      "scope": [
        "source",
        "text"
      ],
      "settings": {
        "foreground": "#cddadf"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other.readwrite",
        "meta.definition.variable.name"
      ],
      "settings": {
        "foreground": "#cddadf"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator"
