      "settings": {
        "foreground": "#eab00a"
      }
    },
    {
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "entity.name.type.module",
        "storage.modifier.import",
        "storage.modifier.package"
      ],
      "settings": {
        "foreground": "#a49cff"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "meta.parameter variable",
        "entity.name.variable.parameter"
