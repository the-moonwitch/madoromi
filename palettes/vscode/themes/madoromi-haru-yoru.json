      "settings": {
        "foreground": "#ffc849"
      }
    },
    {
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "entity.name.type.module",
        "storage.modifier.import",
        "storage.modifier.package"
      ],
      "settings": {
        "foreground": "#99b2f5"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "meta.parameter variable",
        "entity.name.variable.parameter"
      ],
      "settings": {
        "foreground": "#ffa2b5",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "variable.other.property",
